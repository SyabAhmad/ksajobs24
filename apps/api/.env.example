# ─── API (Render · FastAPI) ───────────────────
ENV=development
PORT=8000

# CORS — comma-separated (web + admin dev servers)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Auth ─────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# ─── Cloudflare D1 (database, via REST API) ───
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# ─── Cloudflare R2 (media, S3-compatible) ─────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ksajobs24-media
R2_PUBLIC_URL=
